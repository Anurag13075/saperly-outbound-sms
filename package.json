{
  "name": "saperly-dial",
  "version": "0.1.0",
  "description": "CLI tool — type a message, call a phone number, Saperly reads it aloud",
  "keywords": ["saperly", "cli", "telephony", "ai-agents", "tts"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "saperly-dial": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@saperly/sdk": "^0.2.0",
    "ora": "^8.0.1",
    "chalk": "^5.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
